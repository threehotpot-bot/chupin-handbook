  {
    "name": "凉面",
    "category": "主食",
    "image": "",
    "ingredients": [
      {
        "name": "普通面条",
        "amount": "480g"
      },
      {
        "name": "熟大豆油",
        "amount": "15g"
      }
    ],
    "steps": [
      "将三份 160 克的面条完全煮熟。",
      "出锅后马上用水枪充分冲水，至少 1 分钟。",
      "甩干水分",
      "放在包完保鲜膜的不锈钢盘上，戴手套将每根面打散。",
      "倒入熟油 15 克。",
      "再次搅拌到每根都不粘连。",
      "放入保鲜冰箱待用。"
    ],
    "notes": "保质期一天，每天准备，不要隔夜。",
    "cookingTime": 10,
    "id": 1775047240598
  },
